material {
    name : "ShadowCaster",
    shadingModel : lit,
    blending : masked,
    maskThreshold : 0.3,
    castShadows : true,
    colorWrite : false,
    depthWrite : true,
    requires : [ uv0 ],
    parameters : [
        {
            type : sampler2d,
            name : maskTexture
        }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float confidence = texture(materialParams_maskTexture, getUV0()).a;
        material.baseColor = vec4(0.0, 0.0, 0.0, confidence);
    }
}
